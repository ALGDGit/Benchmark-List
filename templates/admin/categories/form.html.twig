{% extends 'admin/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block admin %}
<h1>{{ title }}</h1>
{{ form_errors(form) }}
{{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.slug) }}
    <button type="submit" class="btn">Save</button>
    <a href="{{ path('admin_categories') }}">Cancel</a>
{{ form_end(form) }}
{% endblock %}
